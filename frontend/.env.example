# Server-only administrator authentication settings. Copy to .env.local.
ADMIN_USERNAME=admin@example.com
ADMIN_EMAIL=admin@example.com
# Optional extra sign-in alias; include country code, e.g. +91 followed by the number.
ADMIN_PHONE=
ADMIN_NAME=System Administrator
# Optional profile image file under public/, for example /avatars/admin.png.
ADMIN_AVATAR_URL=
# Generate with: npm run admin:password-hash
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=
# Password reset mail settings; the SMTP password must remain server-side.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Public HTTPS origin used to build reset links in production.
APP_BASE_URL=http://localhost:3000
# Optional persistent path for the hashed password/reset-token store.
# Defaults to .private/admin-auth.json inside the project.
ADMIN_AUTH_STORE_PATH=
# Optional persistent directory for uploaded profile images.
# Defaults to .private/admin-profiles inside the project.
ADMIN_PROFILE_STORE_PATH=
# Local-only dashboard preview. The code also requires NODE_ENV=development.
NEXT_PUBLIC_DEV_ADMIN_PREVIEW=false
# Optional email and phone aliases for the local demo login.
DEV_DEMO_ADMIN_EMAIL=
DEV_DEMO_ADMIN_PHONE=
DEV_DEMO_ADMIN_AVATAR_URL=
